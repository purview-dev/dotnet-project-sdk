<Project>
	<PropertyGroup>
		<NamespacePrefix>Purview.Aspire.ResourceKit</NamespacePrefix>
		<ExcludePurviewTelemetry>true</ExcludePurviewTelemetry>
	</PropertyGroup>

	<Import Project="$(MSBuildThisFileDirectory)../src/src/DotNetProjectSdk/Sdk/Sdk.props" />

	<PropertyGroup>
		<NoWarn>$(NoWarn);CA1062;CA1515;CA2007;CA1873;</NoWarn>
	</PropertyGroup>
</Project>
