<Project>
	<Import Project="$(MSBuildThisFileDirectory)Props/Defaults.props" />
	<Import Project="$(MSBuildThisFileDirectory)Props/VersionDetection.props " />

	<!-- =====================================================================
	     SHARED PROJECT NAMES
	     Single source of truth for shared project names.
	     Defined as a property (semicolon-fenced) so IsSharedProject and IsSharedTestingProject
	     detection can use $(...Contains(...)) directly in a static Condition.
	     ===================================================================== -->
	<PropertyGroup Label="Defining Shared Project Names">
		<_SharedProjectNames>;Shared;SharedFramework;SharedInfrastructure;SharedInfra;SharedUtilities;SharedUtils;SharedLibrary;SharedLib;SharedHelpers;</_SharedProjectNames>
		<_SharedTestingProjectNames>;SharedTestingFramework;SharedTestingInfrastructure;SharedTestingInfra;SharedTestingUtilities;SharedTestingUtils;SharedTestingLibrary;SharedTestingLib;SharedTestingHelpers;</_SharedTestingProjectNames>
	</PropertyGroup>

	<ItemGroup Label="Defining Shared Project Names">
		<SharedProjectName Include="$(_SharedProjectNames)" />
		<SharedTestingProjectName Include="$(_SharedTestingProjectNames)" />
	</ItemGroup>

	<!-- =====================================================================
	     NAMESPACE SUFFIXES STRIPPED FROM RootNamespace
	     ===================================================================== -->
	<ItemGroup Label="Defining Namespace Suffixes to Remove from RootNamespace">
		<NamespaceRemoveSuffix Include="@(SharedProjectName)" />
		<NamespaceRemoveSuffix Include="@(SharedTestingProjectName)" />
		<NamespaceRemoveSuffix Include="Core" />
		<NamespaceRemoveSuffix Include="EF" />
		<NamespaceRemoveSuffix Include="Shared" />
		<NamespaceRemoveSuffix Include="ClientShared" />
		<NamespaceRemoveSuffix Include="ServiceDefaults" />
	</ItemGroup>

	<!-- =====================================================================
	     TESTING TYPES
	     Controls InternalsVisibleTo generation and TestingType detection.
	     ===================================================================== -->
	<ItemGroup Label="Defining Testing Types">
		<TestType Include="Accessibility" />
		<TestType Include="Acceptance" />
		<TestType Include="Architecture" />
		<TestType Include="BlackBox" />
		<TestType Include="Chaos" />
		<TestType Include="Contract" />
		<TestType Include="E2E" />
		<TestType Include="EndToEnd" />
		<TestType Include="Environment" />
		<TestType Include="Functional" />
		<TestType Include="Interactive" />
		<TestType Include="Integration" />
		<TestType Include="Load" />
		<TestType Include="Performance" />
		<TestType Include="Regression" />
		<TestType Include="Security" />
		<TestType Include="Scenario" />
		<TestType Include="Smoke" />
		<TestType Include="Stress" />
		<TestType Include="System" />
		<TestType Include="Threat" />
		<TestType Include="Unit" />
		<TestType Include="WhiteBox" />
	</ItemGroup>

	<!-- =====================================================================
	     PROJECT TYPE DETECTION
	     Runs for all .csproj files to classify project types and detect the
	     testing type from the project name suffix.
	     ===================================================================== -->
	<PropertyGroup Label="Define C# Properties" Condition="'$(MSBuildProjectExtension)' == '.csproj'">
		<!-- Set some defaults -->
		<IsCSharpProject>true</IsCSharpProject>
		<ExcludePurviewTelemetry Condition="'$(ExcludePurviewTelemetry)' == ''"
			>false</ExcludePurviewTelemetry
		>
		<ExcludeMSTelemetryExtension Condition="'$(ExcludeMSTelemetryExtension)' == ''"
			>false</ExcludeMSTelemetryExtension
		>
		<DisableGenerateAssemblyInfoClass Condition="'$(DisableGenerateAssemblyInfoClass)' == ''"
			>false</DisableGenerateAssemblyInfoClass
		>
		<DisableAutoInternalsVisibleTo Condition="'$(DisableAutoInternalsVisibleTo)' == ''"
			>false</DisableAutoInternalsVisibleTo
		>
		<AutoIncludeUsings Condition="'$(AutoIncludeUsings)' == ''">true</AutoIncludeUsings>
		<!-- Test project types -->
		<IsTestProject>false</IsTestProject>
		<IsSharedTestingProject>false</IsSharedTestingProject>
		<!-- Project types -->
		<IsSharedProject>false</IsSharedProject>
		<IsContainerProject>false</IsContainerProject>
		<IsSdkProject>false</IsSdkProject>
		<IsWebProject>false</IsWebProject>
		<IsWebSdkProject>false</IsWebSdkProject>
		<IsWorkerSdkProject>false</IsWorkerSdkProject>
		<IsAspireHostProject>false</IsAspireHostProject>
		<IsCLIProject>false</IsCLIProject>
		<!-- SDK project type detection by parsing the Sdk attribute -->
		<SdkProjectName>$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText(`$(MSBuildProjectFullPath)`)), `(?s-i)(?:^|\s|&gt;)(?s-i)(?:^|\s|&gt;)&lt;\s*(?:Project|Import)\s(?:[^&gt;]*?)\s?Sdk\s*="(?&lt;sdkproj&gt;.*?)"`).Groups['sdkproj'].Value)</SdkProjectName>
		<IsSdkProject Condition="'$(SdkProjectName)' != ''">true</IsSdkProject>
		<IsWebSdkProject Condition="'$(SdkProjectName)' == 'Microsoft.NET.Sdk.Web'"
			>true</IsWebSdkProject
		>
		<IsWorkerSdkProject Condition="'$(SdkProjectName)' == 'Microsoft.NET.Sdk.Worker'"
			>true</IsWorkerSdkProject
		>
		<IsContainerProject
			Condition="Exists('$(MSBuildProjectDirectory)\Dockerfile') OR Exists('$(MSBuildProjectDirectory)\dockerfile') OR Exists('$(MSBuildProjectDirectory)\Dockerfile.dev')"
			>true</IsContainerProject
		>
		<IsAspireHostProject
			Label="Detect Aspire.Sdk.Host SDK projects - only works when the SDK attribute is on the Project element"
			Condition="$([System.String]::Copy('$(SdkProjectName)').StartsWith('Aspire.Sdk.Host')) == 'True' OR $([System.String]::Copy('$(SdkProjectName)').StartsWith('Aspire.AppHost.Sdk')) == 'True'"
			>true</IsAspireHostProject
		>
		<IsCLIProject
			Condition="$([System.String]::Copy('$(MSBuildProjectName)').EndsWith('CLI')) == 'True' OR $([System.String]::Copy('$(MSBuildProjectName)').EndsWith('Console')) == 'True' OR $([System.String]::Copy('$(MSBuildProjectName)').EndsWith('CommandLine')) == 'True' OR $([System.String]::Copy('$(MSBuildProjectName)').EndsWith('QuickStart')) == 'True' OR $([System.String]::Copy('$(MSBuildProjectName)').EndsWith('QuickStarts')) == 'True'"
			>true</IsCLIProject
		>
		<IsSharedProject
			Condition="$([System.String]::Copy('$(_SharedProjectNames)').Contains(';$(MSBuildProjectName);')) == 'True'"
			>true</IsSharedProject
		>
		<PurviewNamespacePrefix Condition="'$(PurviewNamespacePrefix)' == ''"
			>$(NamespacePrefix)</PurviewNamespacePrefix
		>
		<NamespacePrefix Condition="'$(NamespacePrefix)' == ''">$(PurviewNamespacePrefix)</NamespacePrefix>
		<PurviewProjectShortName>$(MSBuildProjectName)</PurviewProjectShortName>
		<_PurviewEscapedNamespacePrefix
			Condition="'$(PurviewNamespacePrefix)' != ''"
			>$([System.Text.RegularExpressions.Regex]::Escape('$(PurviewNamespacePrefix)'))</_PurviewEscapedNamespacePrefix
		>
		<_PurviewIsSegmentPrefixedProjectName
			Condition="'$(PurviewNamespacePrefix)' != '' AND $([System.Text.RegularExpressions.Regex]::IsMatch('$(MSBuildProjectName)', '^$(_PurviewEscapedNamespacePrefix)($|\.)'))"
			>true</_PurviewIsSegmentPrefixedProjectName
		>
		<PurviewLogicalProjectName
			Condition="'$(PurviewNamespacePrefix)' == ''"
			>$(MSBuildProjectName)</PurviewLogicalProjectName
		>
		<PurviewLogicalProjectName
			Condition="'$(PurviewNamespacePrefix)' != '' AND '$(_PurviewIsSegmentPrefixedProjectName)' == 'true'"
			>$(MSBuildProjectName)</PurviewLogicalProjectName
		>
		<PurviewLogicalProjectName
			Condition="'$(PurviewNamespacePrefix)' != '' AND '$(_PurviewIsSegmentPrefixedProjectName)' != 'true'"
			>$(PurviewNamespacePrefix).$(MSBuildProjectName)</PurviewLogicalProjectName
		>
		<!-- Determine the testing type from the project name suffix -->
		<TestingType
			Condition="$([System.String]::Copy('$(MSBuildProjectName)').EndsWith('Test')) == 'True' OR $([System.String]::Copy('$(MSBuildProjectName)').EndsWith('Tests')) == 'True'"
			>$([System.Text.RegularExpressions.Regex]::Match($(MSBuildProjectName), `^.*\.([\w|_]\w*)Tests?$`).get_Groups().get_Item(1).ToString())</TestingType
		>
		<PurviewTestType Condition="'$(TestingType)' != ''">$(TestingType)Tests</PurviewTestType>
		<IsTestProject Condition="'$(TestingType)' != ''">true</IsTestProject>
		<IsSharedTestingProject
			Condition="$([System.String]::Copy('$(_SharedTestingProjectNames)').Contains(';$(MSBuildProjectName);')) == 'True'"
			>true</IsSharedTestingProject
		>
	</PropertyGroup>

	<!-- =====================================================================
	     TESTING FRAMEWORKS
	     Defaults:
	     - TestingFramework: TUnit (supported: TUnit, Xunit, None)
	     - SubstituteFramework: TUnitMocks (supported: TUnitMocks, NSubstitute, None)
	     - TestDataFramework: Bogus (supported: Bogus, None)
	     ===================================================================== -->
	<PropertyGroup Label="Testing Framework Selection">
		<!--<_TestingFrameworkRaw>$(TestingFramework)</_TestingFrameworkRaw>-->
		<_TestingFrameworkNormalized>$([System.String]::Copy('$(TestingFramework)').Trim().ToLowerInvariant())</_TestingFrameworkNormalized>

		<!--<TestingFramework Condition="'$(_TestingFrameworkNormalized)' == '' OR '$(_TestingFrameworkNormalized)' == 'tunit'">TUnit</TestingFramework>
		<TestingFramework Condition="'$(_TestingFrameworkNormalized)' == 'xunit'">Xunit</TestingFramework>
		<TestingFramework Condition="'$(_TestingFrameworkNormalized)' == 'none'">None</TestingFramework>-->
	</PropertyGroup>

	<PropertyGroup Label="Substitution Framework Selection">
		<!--<_SubstituteFrameworkRaw>$(SubstituteFramework)</_SubstituteFrameworkRaw>-->
		<_SubstituteFrameworkNormalized>$([System.String]::Copy('$(SubstituteFramework)').Trim().ToLowerInvariant())</_SubstituteFrameworkNormalized>

		<!--<SubstituteFramework Condition="'$(_SubstituteFrameworkNormalized)' == '' OR '$(_SubstituteFrameworkNormalized)' == 'tunit.mocks'">TUnitMocks</SubstituteFramework>
		<SubstituteFramework Condition="'$(_SubstituteFrameworkNormalized)' == 'nsubstitute'">NSubstitute</SubstituteFramework>
		<SubstituteFramework Condition="'$(_SubstituteFrameworkNormalized)' == 'none'">None</SubstituteFramework>-->
	</PropertyGroup>

	<PropertyGroup Label="Testing Framework Data Selection">
		<!--<_TestDataFrameworkRaw>$(TestDataFramework)</_TestDataFrameworkRaw>-->
		<_TestDataFrameworkNormalized>$([System.String]::Copy('$(TestDataFramework)').Trim().ToLowerInvariant())</_TestDataFrameworkNormalized>

		<!--<TestDataFramework Condition="'$(_TestDataFrameworkNormalized)' == '' OR '$(_TestDataFrameworkNormalized)' == 'bogus'">Bogus</TestDataFramework>
		<TestDataFramework Condition="'$(_TestDataFrameworkNormalized)' == 'none'">None</TestDataFramework>-->
	</PropertyGroup>

	<!-- =====================================================================
	     COMPILER-VISIBLE SDK PROPERTIES
	     Exposes SDK properties to Roslyn analyzers/source generators via
	     AnalyzerConfigOptions as build_property.<PropertyName>.
	     ===================================================================== -->
	<ItemGroup Label="Compiler Visible SDK Properties" Condition="'$(IsCSharpProject)' == 'true'">
		<CompilerVisibleProperty Include="NamespacePrefix">
			<Description>Required namespace prefix used to derive RootNamespace for projects.</Description>
		</CompilerVisibleProperty>
		<CompilerVisibleProperty Include="DisableNamespacePrefixCheck">
			<Description>Disables the build error that requires NamespacePrefix to be set.</Description>
		</CompilerVisibleProperty>
		<CompilerVisibleProperty Include="TestingFramework">
			<Description>Selected testing framework (TUnit, Xunit, or None). Defaults to TUnit.</Description>
		</CompilerVisibleProperty>
		<CompilerVisibleProperty Include="SubstituteFramework">
			<Description>Selected mocking/substitute framework (TUnitMocks, NSubstitute, or None). Defaults to TUnitMocks.</Description>
		</CompilerVisibleProperty>
		<CompilerVisibleProperty Include="TestDataFramework">
			<Description>Selected test data framework (Bogus or None). Defaults to Bogus.</Description>
		</CompilerVisibleProperty>
		<CompilerVisibleProperty Include="SourceLinkPackageName">
			<Description>NuGet package ID used for SourceLink integration.</Description>
		</CompilerVisibleProperty>
		<CompilerVisibleProperty Include="DisableSourceLink">
			<Description>Disables automatic SourceLink integration.</Description>
		</CompilerVisibleProperty>
		<CompilerVisibleProperty Include="ExcludePurviewTelemetry">
			<Description>Opt-out flag that removes Purview telemetry source-generator integration.</Description>
		</CompilerVisibleProperty>
		<CompilerVisibleProperty Include="ExcludeMSTelemetryExtension">
			<Description>Opt-out flag that removes Microsoft.Extensions.Telemetry.Abstractions.</Description>
		</CompilerVisibleProperty>
		<CompilerVisibleProperty Include="DisableGenerateAssemblyInfoClass">
			<Description>Disables generation of the AssemblyInfo helper class in intermediate output.</Description>
		</CompilerVisibleProperty>
		<CompilerVisibleProperty Include="DisableAutoInternalsVisibleTo">
			<Description>Disables automatic InternalsVisibleTo generation for test and shared testing projects.</Description>
		</CompilerVisibleProperty>
		<CompilerVisibleProperty Include="AutoIncludeUsings">
			<Description>Controls SDK-added global usings for NamespacePrefix and RootNamespace.</Description>
		</CompilerVisibleProperty>
		<CompilerVisibleProperty Include="IsCSharpProject">
			<Description>True when the current project is a C# project (*.csproj).</Description>
		</CompilerVisibleProperty>
		<CompilerVisibleProperty Include="IsTestProject">
			<Description>True when the project name matches a supported *Test/*Tests suffix.</Description>
		</CompilerVisibleProperty>
		<CompilerVisibleProperty Include="IsSharedTestingProject">
			<Description>True for known shared testing helper projects (SharedTestingFramework, etc.).</Description>
		</CompilerVisibleProperty>
		<CompilerVisibleProperty Include="TestingType">
			<Description>Detected test category suffix from project name (Unit, Integration, E2E, etc.).</Description>
		</CompilerVisibleProperty>
		<CompilerVisibleProperty Include="TargetProjectName">
			<Description>Inferred non-test project name that a test project targets.</Description>
		</CompilerVisibleProperty>
		<CompilerVisibleProperty Include="IsContainerProject">
			<Description>True when a Dockerfile marker indicates container-project defaults should apply.</Description>
		</CompilerVisibleProperty>
		<CompilerVisibleProperty Include="IsSdkProject">
			<Description>True when an SDK value is detected from the project/import declaration.</Description>
		</CompilerVisibleProperty>
		<CompilerVisibleProperty Include="SdkProjectName">
			<Description>Detected SDK name from the project/import declaration (for example Microsoft.NET.Sdk.Web).</Description>
		</CompilerVisibleProperty>
		<CompilerVisibleProperty Include="IsWebProject">
			<Description>Marker used to distinguish API/web project behavior in SDK logic.</Description>
		</CompilerVisibleProperty>
		<CompilerVisibleProperty Include="IsWebSdkProject">
			<Description>True when SdkProjectName is Microsoft.NET.Sdk.Web.</Description>
		</CompilerVisibleProperty>
		<CompilerVisibleProperty Include="IsWorkerSdkProject">
			<Description>True when SdkProjectName is Microsoft.NET.Sdk.Worker.</Description>
		</CompilerVisibleProperty>
		<CompilerVisibleProperty Include="IsAspireHostProject">
			<Description>True when the project SDK starts with Aspire.Sdk.Host.</Description>
		</CompilerVisibleProperty>
		<CompilerVisibleProperty Include="EditorConfigFilePath">
			<Description>Path to the SDK-provided .editorconfig used for build-time style enforcement.</Description>
		</CompilerVisibleProperty>
		<CompilerVisibleProperty Include="RepositoryEditorConfigFilePath">
			<Description>Destination path for bootstrapping a physical repo-level .editorconfig when missing.</Description>
		</CompilerVisibleProperty>
		<CompilerVisibleProperty Include="BootstrapEditorConfigToRepoRoot">
			<Description>When true, copies the SDK .editorconfig to RepositoryEditorConfigFilePath if that file does not exist.</Description>
		</CompilerVisibleProperty>
		<CompilerVisibleProperty Include="RepositoryGlobalJsonFilePath">
			<Description>Destination path for bootstrapping a physical repo-level global.json when missing.</Description>
		</CompilerVisibleProperty>
		<CompilerVisibleProperty Include="BootstrapGlobalJsonToRepoRoot">
			<Description>When true, bootstraps global.json to RepositoryGlobalJsonFilePath if that file does not exist.</Description>
		</CompilerVisibleProperty>
		<CompilerVisibleProperty Include="DisableAutoCopySdkFiles">
			<Description>When true, disables SDK auto-copy bootstrapping for repository files such as .editorconfig and global.json.</Description>
		</CompilerVisibleProperty>
		<CompilerVisibleProperty Include="PurviewDotNetProjectSdkVersionForGlobalJson">
			<Description>Version written to the msbuild-sdks Purview.DotNetProjectSdk entry when bootstrapping global.json.</Description>
		</CompilerVisibleProperty>
		<CompilerVisibleProperty Include="CurrentYear">
			<Description>Current year value used by generated assembly metadata.</Description>
		</CompilerVisibleProperty>
		<CompilerVisibleProperty Include="AutoGeneratedAssemblyInfoFile">
			<Description>Relative path to the SDK-generated AssemblyInfo source file.</Description>
		</CompilerVisibleProperty>
		<CompilerVisibleProperty Include="IsCLIProject">
			<Description>True when the project is a CLI project.</Description>
		</CompilerVisibleProperty>
		<CompilerVisibleProperty Include="IsSharedProject">
			<Description>True when the project is a shared project.</Description>
		</CompilerVisibleProperty>
	</ItemGroup>

	<!-- =====================================================================
	     C# PROJECT DEFAULTS
	     ===================================================================== -->
	<PropertyGroup Label="C# Project Property Groups" Condition="'$(IsCSharpProject)' == 'true'">
		<TargetFramework Condition="'$(TargetFramework)' == '' AND '$(TargetFrameworks)' == ''"
			>net10.0</TargetFramework
		>
		<LangVersion>preview</LangVersion>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
		<Deterministic>true</Deterministic>
		<!-- Auto-detect CI environment from common env vars -->
		<ContinuousIntegrationBuild
			Condition="'$(CI)' == 'true' OR '$(GITHUB_ACTIONS)' == 'true' OR '$(TF_BUILD)' == 'true' OR '$(IsPackable)' == 'true'"
			>true</ContinuousIntegrationBuild
		>
		<EmbedUntrackedSources>true</EmbedUntrackedSources>
		<AccelerateBuildsInVisualStudio>true</AccelerateBuildsInVisualStudio>
		<!-- EditorConfig from the NuGet package Sdk/ folder — used for build-time code-style enforcement -->
		<EditorConfigFilePath>$(MSBuildThisFileDirectory).editorconfig</EditorConfigFilePath>
		<!-- Also bootstrap a physical repo-level .editorconfig for tools (for example CSharpier) that don't read @(EditorConfigFiles). -->
		<DisableAutoCopySdkFiles Condition="'$(DisableAutoCopySdkFiles)' == ''"
			>false</DisableAutoCopySdkFiles
		>
		<BootstrapEditorConfigToRepoRoot Condition="'$(BootstrapEditorConfigToRepoRoot)' == ''"
			>true</BootstrapEditorConfigToRepoRoot
		>
		<RepositoryEditorConfigFilePath
			Condition="'$(RepositoryEditorConfigFilePath)' == ''"
		></RepositoryEditorConfigFilePath>
		<BootstrapGlobalJsonToRepoRoot Condition="'$(BootstrapGlobalJsonToRepoRoot)' == ''"
			>true</BootstrapGlobalJsonToRepoRoot
		>
		<RepositoryGlobalJsonFilePath
			Condition="'$(RepositoryGlobalJsonFilePath)' == ''"
		></RepositoryGlobalJsonFilePath>
		<_PurviewSdkContainerDirectory>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..'))</_PurviewSdkContainerDirectory>
		<_PurviewSdkContainerDirectoryName>$([System.IO.Path]::GetFileName('$(_PurviewSdkContainerDirectory)'))</_PurviewSdkContainerDirectoryName>
		<PurviewDotNetProjectSdkVersionForGlobalJson
			Condition="'$(PurviewDotNetProjectSdkVersionForGlobalJson)' == '' AND $([System.Text.RegularExpressions.Regex]::IsMatch('$(_PurviewSdkContainerDirectoryName)', '^\d+\.\d+\.\d+([-.].+)?$'))"
			>$(_PurviewSdkContainerDirectoryName)</PurviewDotNetProjectSdkVersionForGlobalJson
		>
		<PurviewDotNetProjectSdkVersionForGlobalJson
			Condition="'$(PurviewDotNetProjectSdkVersionForGlobalJson)' == ''"
			>1.0.0</PurviewDotNetProjectSdkVersionForGlobalJson
		>
		<!-- Sensible default for SourceLink (override by setting SourceLinkPackageName) -->
		<SourceLinkPackageName Condition="'$(SourceLinkPackageName)' == ''">Microsoft.SourceLink.GitHub</SourceLinkPackageName
		>
		<DisableSourceLink>false</DisableSourceLink>
		<GenerateAssemblyCompanyAttribute>false</GenerateAssemblyCompanyAttribute>
		<GenerateAssemblyCopyrightAttribute>false</GenerateAssemblyCopyrightAttribute>
		<IsPackable Condition="'$(IsPackable)' == ''">false</IsPackable>
		<EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
		<EnableNETAnalyzers>true</EnableNETAnalyzers>
		<AnalysisMode>All</AnalysisMode>
		<AnalysisLevel>Latest</AnalysisLevel>
		<NoWarn>AD0001;$(NoWarn)</NoWarn>
		<NoWarn>IDE2001;$(NoWarn)</NoWarn>
		<NoWarn>CA1014;CA1848;CA2007;CA2201;CA2225;CA2254;$(NoWarn)</NoWarn>
		<NoWarn>RCS1090;RCS1108;$(NoWarn)</NoWarn>
		<CurrentYear>$([System.DateTime]::Now.Year)</CurrentYear>
		<Version Condition="'$(Version)' == ''">0.0.1</Version>
		<PackageVersion Condition="'$(PackageVersion)' == ''">$(Version)</PackageVersion>
		<!-- Path for the auto-generated assembly info class -->
		<AutoGeneratedAssemblyInfoFile>$(IntermediateOutputPath)/Properties/GeneratedAssemblyInfo.cs</AutoGeneratedAssemblyInfoFile>
	</PropertyGroup>

	<PropertyGroup
		Label="Aspire Host Project Properties"
		Condition="'$(IsAspireHostProject)' == 'true' AND '$(IsTestProject)' != 'true' AND '$(IsSharedTestingProject)' != 'true'"
	>
		<OutputType Condition="'$(OutputType)' == ''">Exe</OutputType>
		<!--
			When  using things like SpectreConsole, you generally define the settings
			as a nested public class to the internal command. However, this still forces
			CA1515 to be created which is a pain as it's not really relevant.
		-->
		<NoWarn>$(NoWarn);CA1515;</NoWarn>
	</PropertyGroup>

	<PropertyGroup
		Label="CLI Project Properties"
		Condition="'$(IsCLIProject)' == 'true' AND '$(IsTestProject)' != 'true' AND '$(IsSharedTestingProject)' != 'true'"
	>
		<OutputType Condition="'$(OutputType)' == ''">Exe</OutputType>
		<!--
			When  using things like SpectreConsole, you generally define the settings
			as a nested public class to the internal command. However, this still forces
			CA1515 to be created which is a pain as it's not really relevant.
		-->
		<NoWarn>$(NoWarn);CA1515;</NoWarn>
	</PropertyGroup>

	<ItemGroup Label="CLI Item Properties" Condition="'$(IsCLIProject)' == 'true'">
		<Content Include="appsettings*.json" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>

	<ItemGroup
		Label="C# Analyzer Config Files"
		Condition="'$(IsCSharpProject)' == 'true' AND Exists('$(EditorConfigFilePath)')"
	>
		<EditorConfigFiles Include="$(EditorConfigFilePath)" />
	</ItemGroup>

	<!-- Default assembly and namespace from logical project identity -->
	<PropertyGroup>
		<AssemblyName
			Condition="('$(AssemblyName)' == '' OR '$(AssemblyName)' == '$(MSBuildProjectName)') AND '$(PurviewLogicalProjectName)' != ''"
			>$(PurviewLogicalProjectName)</AssemblyName
		>
		<RootNamespace
			Condition="('$(RootNamespace)' == '' OR '$(RootNamespace)' == '$(MSBuildProjectName)') AND '$(PurviewLogicalProjectName)' != ''"
			>$(PurviewLogicalProjectName)</RootNamespace
		>
	</PropertyGroup>

	<!-- Test project target resolution -->
	<PropertyGroup Label="C# Test Properties" Condition="'$(IsTestProject)' == 'true'">
		<TargetProjectName>$([System.Text.RegularExpressions.Regex]::Replace($(MSBuildProjectName), `[.]$(TestingType)Tests?$$`, ``))</TargetProjectName>
	</PropertyGroup>

	<!-- =====================================================================
	     C# PROJECT ITEM GROUPS
	     ===================================================================== -->
	<ItemGroup Label="C# Project Item Groups" Condition="'$(IsCSharpProject)' == 'true'">
		<!-- Implicit usings -->
		<Using
			Condition="'$(AutoIncludeUsings)' == 'true' AND '$(NamespacePrefix)' != ''"
			Include="$(NamespacePrefix)"
		/>
		<Using Condition="'$(AutoIncludeUsings)' == 'true'" Include="$(RootNamespace)" />
		<!-- InternalsVisibleTo for Moq/NSubstitute dynamic proxies -->
		<AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
			<_Parameter1>"DynamicProxyGenAssembly2"</_Parameter1>
		</AssemblyAttribute>
		<!-- Exclusions -->
		<None Remove="$(MSBuildProjectName).v3.ncrunchproject" />
		<None Remove="$(AssemblyName).xml" />
		<Compile Remove="TestResults/**" />
		<Content Remove="TestResults/**" />
		<EmbeddedResource Remove="TestResults/**" />
		<None Remove="TestResults/**" />
		<!-- Embedded resources -->
		<None Remove="Resources/**/*" />
		<EmbeddedResource Include="Resources/**/*" />
		<EmbeddedResource Include="FileSystemResources\**\*">
			<LogicalName>%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
		</EmbeddedResource>
	</ItemGroup>

	<!-- =====================================================================
	     FILE CONTENT OPTIONS
	     ===================================================================== -->
	<ItemGroup Label="C# File Content Options" Condition="'$(IsCSharpProject)' == 'true'">
		<None Remove="$(AssemblyName).xml" />
		<Compile Remove="TestResults/**" />
		<Content Remove="TestResults/**" />
		<EmbeddedResource Remove="TestResults/**" />
		<None Remove="TestResults/**" />
	</ItemGroup>

	<!-- =====================================================================
	     CONTAINER PROJECTS
	     ===================================================================== -->
	<PropertyGroup
		Label="Container Project"
		Condition="'$(IsContainerProject)' == 'true' AND '$(IsTestProject)' != 'true'"
	>
		<InvariantGlobalization>true</InvariantGlobalization>
		<PublishAot>true</PublishAot>
		<DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
		<DockerfileContext>..\..\</DockerfileContext>
	</PropertyGroup>
	
	<ItemGroup
		Label="Container Project"
		Condition="'$(IsContainerProject)' == 'true' AND '$(IsTestProject)' != 'true'"
	>
		<PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" />
	</ItemGroup>

	<!-- =====================================================================
	     WEB PROJECTS (non-API web apps that need OpenAPI interceptors)
	     ===================================================================== -->
	<PropertyGroup
		Label="Web Project"
		Condition="'$(IsWebSdkProject)' == 'true' AND '$(IsWebProject)' != 'true'"
	>
		<InterceptorsNamespaces>$(InterceptorsNamespaces);Microsoft.AspNetCore.OpenApi.Generated</InterceptorsNamespaces>
	</PropertyGroup>

	<!-- =====================================================================
	     LIBRARY PROJECTS
	     ===================================================================== -->
	<PropertyGroup
		Label="Library Project Properties"
		Condition="'$(IsCSharpProject)' == 'true' AND '$(IsTestProject)' != 'true' AND '$(IsSharedTestingProject)' != 'true'"
	>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<AllowedOutputExtensionsInPackageBuildOutputFolder>$(AllowedOutputExtensionsInPackageBuildOutputFolder);.xml</AllowedOutputExtensionsInPackageBuildOutputFolder>
	</PropertyGroup>

	<!-- =====================================================================
	     NUGET PACKAGE PROJECTS
	     ===================================================================== -->
	<PropertyGroup Label="NuGet Package Project Properties" Condition="'$(IsPackable)' == 'true'">
		<AllowedOutputExtensionsInPackageBuildOutputFolder>$(AllowedOutputExtensionsInPackageBuildOutputFolder);.pdb</AllowedOutputExtensionsInPackageBuildOutputFolder>
		<PackageTags>$(PackageTags);</PackageTags>
		<IncludeSource>true</IncludeSource>
		<IncludeSymbols>true</IncludeSymbols>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
	</PropertyGroup>

	<!-- =====================================================================
	     PURVIEW TELEMETRY — OPT-OUT (set ExcludePurviewTelemetry=true to skip)
	     ===================================================================== -->
	<ItemGroup
		Label="C# Telemetry Packages"
		Condition="'$(IsCSharpProject)' == 'true' AND '$(IsTestProject)' != 'true' AND '$(ExcludePurviewTelemetry)' != 'true'"
	>
		<PackageReference Include="Purview.Telemetry.SourceGenerator">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>analyzers</IncludeAssets>
		</PackageReference>
		<PackageReference
			Condition="'$(ExcludeMSTelemetryExtension)' != 'true'"
			Include="Microsoft.Extensions.Telemetry.Abstractions"
		/>
	</ItemGroup>

	<!-- =====================================================================
	     SOURCELINK — auto-added to all non-test projects
	     ===================================================================== -->
	<ItemGroup
		Label="NuGet Package References"
		Condition="'$(IsTestProject)' != 'true' AND '$(IsSharedTestingProject)' != 'true' AND '$(DisableSourceLink)' != 'true' AND '$(SourceLinkPackageName)' != ''"
	>
		<PackageReference Include="$(SourceLinkPackageName)">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
		</PackageReference>
	</ItemGroup>

	<!-- =====================================================================
	     SHARED TEST PROJECT PROPERTIES
	     ===================================================================== -->
	<PropertyGroup
		Condition="'$(IsTestProject)' == 'true' OR '$(IsSharedTestingProject)' == 'true'"
		Label="C# Shared Testing Project Properties"
	>
		<NoWarn>$(NoWarn);CA1062;CA1515;CA1707;CA1822;</NoWarn>
		<NoWarn>$(NoWarn);CS1591;</NoWarn>
		<Packable>false</Packable>
		<IsPackable>false</IsPackable>
		<IsPublishable>false</IsPublishable>
	</PropertyGroup>
	
	<PropertyGroup Label="Testing Project Properties" Condition="'$(IsTestProject)' == 'true'">
		<OutputType Condition="'$(_TestingFrameworkNormalized)' != 'none'">Exe</OutputType>
		<MaxCpuCount>0</MaxCpuCount>
		<CollectCoverage>true</CollectCoverage>
		<Exclude>[NSubstitute*]*,[TUnit.*]*,[xunit.*]*,[Microsoft.Testing.*]*,[Microsoft.NET.Test*]*,[Bogus*]*</Exclude>
		<ExcludeByAttribute>System.Diagnostics.CodeAnalysis.ExcludeFromCodeCoverageAttribute</ExcludeByAttribute>
		<IsPackable>false</IsPackable>
		<IsPublishable>false</IsPublishable>
		<!-- Disable native instrumentation unless C++ is involved -->
		<EnableStaticNativeInstrumentation>false</EnableStaticNativeInstrumentation>
		<EnableDynamicNativeInstrumentation>false</EnableDynamicNativeInstrumentation>
	</PropertyGroup>
	
	<PropertyGroup
		Label="Testing NuGet Packages"
		Condition="'$(IsTestProject)' == 'true' OR '$(IsSharedTestingProject)' == 'true'"
	>
		<DisableGenerateAssemblyInfoClass>true</DisableGenerateAssemblyInfoClass>
	</PropertyGroup>
	
	<ItemGroup
		Label="Testing NuGet Packages"
		Condition="'$(IsTestProject)' == 'true' OR '$(IsSharedTestingProject)' == 'true'"
	>
		<AssemblyAttribute Include="System.Diagnostics.CodeAnalysis.ExcludeFromCodeCoverageAttribute" />
	</ItemGroup>
	
	<ItemGroup
		Label="Substitute Framework NuGet Packages"
		Condition="('$(IsTestProject)' == 'true' OR '$(IsSharedTestingProject)' == 'true') AND '$(_SubstituteFrameworkNormalized)' == 'nsubstitute'"
	>
		<Using Include="NSubstitute" />
		<PackageReference Include="NSubstitute" />
		<PackageReference Include="NSubstitute.Analyzers.CSharp">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
		</PackageReference>
	</ItemGroup>
	
	<ItemGroup
		Label="Substitute Framework NuGet Packages"
		Condition="('$(IsTestProject)' == 'true' OR '$(IsSharedTestingProject)' == 'true') AND '$(_SubstituteFrameworkNormalized)' == 'tunitmocks'"
	>
		<PackageReference Include="TUnit.Mocks" />
	</ItemGroup>
	
	<ItemGroup
		Label="Test Data Framework NuGet Packages"
		Condition="('$(IsTestProject)' == 'true' OR '$(IsSharedTestingProject)' == 'true') AND '$(_TestDataFrameworkNormalized)' == 'bogus'"
	>
		<Using Include="Bogus" />
		<PackageReference Include="Bogus" />
	</ItemGroup>

	<!-- =====================================================================
	     TUNIT TEST PACKAGES (default)
	     ===================================================================== -->
	<PropertyGroup
		Label="TUnit Testing Platform Properties"
		Condition="'$(IsTestProject)' == 'true' AND '$(_TestingFrameworkNormalized)' == 'tunit'"
	>
		<TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
		<UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
		<EnableMicrosoftTestingPlatform>true</EnableMicrosoftTestingPlatform>
	</PropertyGroup>
	
	<ItemGroup
		Label="TUnit NuGet Packages"
		Condition="('$(IsTestProject)' == 'true' OR '$(IsSharedTestingProject)' == 'true') AND '$(_TestingFrameworkNormalized)' == 'tunit'"
	>
		<AssemblyAttribute
			Include="TUnit.Core.Category"
			Condition="'$(IsSharedTestingProject)' != 'true'"
		>
			<_Parameter1>$(TestingType)</_Parameter1>
		</AssemblyAttribute>
		<AssemblyAttribute Include="TUnit.Core.Skip" Condition="'$(IsSharedTestingProject)' == 'true'">
			<_Parameter1>Skipping Shared Testing Project</_Parameter1>
		</AssemblyAttribute>
		<PackageReference Include="TUnit" Condition="'$(IsSharedTestingProject)' != 'true'" />
		<PackageReference Include="TUnit.Core" Condition="'$(IsSharedTestingProject)' == 'true'" />
	</ItemGroup>

	<!-- =====================================================================
	     XUNIT TEST PACKAGES (opt-in: set TestingFramework=Xunit)
	     ===================================================================== -->
	<ItemGroup
		Label="XUnit NuGet Packages"
		Condition="('$(IsTestProject)' == 'true' OR '$(IsSharedTestingProject)' == 'true') AND '$(_TestingFrameworkNormalized)' == 'xunit'"
	>
		<AssemblyAttribute Include="Xunit.Trait" Condition="'$(IsSharedTestingProject)' != 'true'">
			<_Parameter1>Category</_Parameter1>
			<_Parameter2>$(TestingType)</_Parameter2>
		</AssemblyAttribute>
		<PackageReference Include="xunit.v3" Condition="'$(IsSharedTestingProject)' != 'true'" />
		<PackageReference
			Include="xunit.runner.visualstudio"
			Condition="'$(IsSharedTestingProject)' != 'true'"
		>
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
		</PackageReference>
	</ItemGroup>

	<!-- =====================================================================
     AUTOMATIC PROJECT REFERENCES FOR TEST PROJECTS
     Resolves the target project relative to the test project location.
     ===================================================================== -->
	<ItemGroup
		Label="Automatic ProjectReference for Projects"
		Condition="'$(IsTestProject)' != 'true' AND '$(IsSharedProject)' != 'true'"
	>
		<!-- Shared project alongside this one (wildcards silently match 0 files) -->
		<ProjectReference Include="../Shared*/Shared*.csproj" />
		<ProjectReference Remove="../SharedTesting*/SharedTesting*.csproj" />
		<ProjectReference Remove="../$(MSBuildProjectName)/$(MSBuildProjectName).csproj" />
	</ItemGroup>

	<!-- =====================================================================
	     AUTOMATIC PROJECT REFERENCES FOR TEST PROJECTS
	     Resolves the target project relative to the test project location.
	     ===================================================================== -->
	<ItemGroup
		Label="Automatic ProjectReference for Test Projects"
		Condition="'$(IsTestProject)' == 'true' AND '$(IsSharedTestingProject)' != 'true'"
	>
		<ProjectReference
			Include="../$(TargetProjectName)/$(TargetProjectName).csproj"
			Condition="Exists('../$(TargetProjectName)/$(TargetProjectName).csproj')"
		/>
		<ProjectReference
			Include="../../$(TargetProjectName)/$(TargetProjectName).csproj"
			Condition="Exists('../../$(TargetProjectName)/$(TargetProjectName).csproj')"
		/>
		<ProjectReference
			Include="../src/$(TargetProjectName)/$(TargetProjectName).csproj"
			Condition="Exists('../src/$(TargetProjectName)/$(TargetProjectName).csproj')"
		/>
		<ProjectReference
			Include="../../src/$(TargetProjectName)/$(TargetProjectName).csproj"
			Condition="Exists('../../src/$(TargetProjectName)/$(TargetProjectName).csproj')"
		/>
		<!-- Shared testing project alongside this one (wildcards silently match 0 files) -->
		<ProjectReference Include="../SharedTesting*/SharedTesting*.csproj" />
		<ProjectReference Remove="../$(MSBuildProjectName)/$(MSBuildProjectName).csproj" />
	</ItemGroup>
</Project>
