<Project>
	<PropertyGroup Label="Default SDK Properties">
		<_SharedProjectNames Condition="'$(_SharedProjectNames)' == ''"
			>;Shared;SharedFramework;SharedInfrastructure;SharedInfra;SharedUtilities;SharedUtils;SharedLibrary;SharedLib;SharedHelpers;</_SharedProjectNames
		>
		<_SharedTestingProjectNames Condition="'$(_SharedTestingProjectNames)' == ''"
			>;SharedTestingFramework;SharedTestingInfrastructure;SharedTestingInfra;SharedTestingUtilities;SharedTestingUtils;SharedTestingLibrary;SharedTestingLib;SharedTestingHelpers;</_SharedTestingProjectNames
		>

		<AccelerateBuildsInVisualStudio Condition="'$(AccelerateBuildsInVisualStudio)' == ''"
			>false</AccelerateBuildsInVisualStudio
		>
		<AllowedOutputExtensionsInPackageBuildOutputFolder
			Condition="'$(AllowedOutputExtensionsInPackageBuildOutputFolder)' == ''"
		></AllowedOutputExtensionsInPackageBuildOutputFolder>
		<AnalysisLevel Condition="'$(AnalysisLevel)' == ''"></AnalysisLevel>
		<AnalysisMode Condition="'$(AnalysisMode)' == ''"></AnalysisMode>
		<AutoGeneratedAssemblyInfoFile
			Condition="'$(AutoGeneratedAssemblyInfoFile)' == ''"
		></AutoGeneratedAssemblyInfoFile>
		<AutoIncludeUsings Condition="'$(AutoIncludeUsings)' == ''">true</AutoIncludeUsings>
		<BootstrapEditorConfigToRepoRoot Condition="'$(BootstrapEditorConfigToRepoRoot)' == ''"
			>true</BootstrapEditorConfigToRepoRoot
		>
		<BootstrapGlobalJsonToRepoRoot Condition="'$(BootstrapGlobalJsonToRepoRoot)' == ''"
			>true</BootstrapGlobalJsonToRepoRoot
		>
		<CollectCoverage Condition="'$(CollectCoverage)' == ''">false</CollectCoverage>
		<ContinuousIntegrationBuild Condition="'$(ContinuousIntegrationBuild)' == ''"
			>false</ContinuousIntegrationBuild
		>
		<CurrentYear Condition="'$(CurrentYear)' == ''"></CurrentYear>
		<Deterministic Condition="'$(Deterministic)' == ''">false</Deterministic>
		<DisableProjectFileNamingConventionCheck
			Condition="'$(DisableProjectFileNamingConventionCheck)' == ''"
			>false</DisableProjectFileNamingConventionCheck
		>
		<DisableAutoCopySdkFiles Condition="'$(DisableAutoCopySdkFiles)' == ''"
			>false</DisableAutoCopySdkFiles
		>
		<DisableAutoInternalsVisibleTo Condition="'$(DisableAutoInternalsVisibleTo)' == ''"
			>false</DisableAutoInternalsVisibleTo
		>
		<DisableGenerateAssemblyInfoClass Condition="'$(DisableGenerateAssemblyInfoClass)' == ''"
			>false</DisableGenerateAssemblyInfoClass
		>
		<DisableSourceLink Condition="'$(DisableSourceLink)' == ''">false</DisableSourceLink>
		<DockerDefaultTargetOS Condition="'$(DockerDefaultTargetOS)' == ''"></DockerDefaultTargetOS>
		<DockerfileContext Condition="'$(DockerfileContext)' == ''"></DockerfileContext>
		<EditorConfigFilePath Condition="'$(EditorConfigFilePath)' == ''"></EditorConfigFilePath>
		<EmbedUntrackedSources Condition="'$(EmbedUntrackedSources)' == ''"
			>false</EmbedUntrackedSources
		>
		<EnableDynamicNativeInstrumentation Condition="'$(EnableDynamicNativeInstrumentation)' == ''"
			>false</EnableDynamicNativeInstrumentation
		>
		<EnableMicrosoftTestingPlatform Condition="'$(EnableMicrosoftTestingPlatform)' == ''"
			>false</EnableMicrosoftTestingPlatform
		>
		<EnableNETAnalyzers Condition="'$(EnableNETAnalyzers)' == ''">false</EnableNETAnalyzers>
		<EnableStaticNativeInstrumentation Condition="'$(EnableStaticNativeInstrumentation)' == ''"
			>false</EnableStaticNativeInstrumentation
		>
		<EnforceCodeStyleInBuild Condition="'$(EnforceCodeStyleInBuild)' == ''"
			>false</EnforceCodeStyleInBuild
		>
		<Exclude Condition="'$(Exclude)' == ''"></Exclude>
		<ExcludeByAttribute Condition="'$(ExcludeByAttribute)' == ''"></ExcludeByAttribute>
		<ExcludeMSTelemetryExtension Condition="'$(ExcludeMSTelemetryExtension)' == ''"
			>false</ExcludeMSTelemetryExtension
		>
		<ExcludePurviewTelemetry Condition="'$(ExcludePurviewTelemetry)' == ''"
			>false</ExcludePurviewTelemetry
		>
		<GenerateAssemblyCompanyAttribute Condition="'$(GenerateAssemblyCompanyAttribute)' == ''"
			>false</GenerateAssemblyCompanyAttribute
		>
		<GenerateAssemblyCopyrightAttribute Condition="'$(GenerateAssemblyCopyrightAttribute)' == ''"
			>false</GenerateAssemblyCopyrightAttribute
		>
		<GenerateDocumentationFile Condition="'$(GenerateDocumentationFile)' == ''"
			>false</GenerateDocumentationFile
		>
		<ImplicitUsings Condition="'$(ImplicitUsings)' == ''"></ImplicitUsings>
		<IncludeSource Condition="'$(IncludeSource)' == ''">false</IncludeSource>
		<IncludeSymbols Condition="'$(IncludeSymbols)' == ''">false</IncludeSymbols>
		<InterceptorsNamespaces Condition="'$(InterceptorsNamespaces)' == ''"></InterceptorsNamespaces>
		<InvariantGlobalization Condition="'$(InvariantGlobalization)' == ''"
