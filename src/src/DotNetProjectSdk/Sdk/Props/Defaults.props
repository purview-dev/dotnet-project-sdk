		>
		<IsAspireHostProject Condition="'$(IsAspireHostProject)' == ''">false</IsAspireHostProject>
		<IsCLIProject Condition="'$(IsCLIProject)' == ''">false</IsCLIProject>
		<IsContainerProject Condition="'$(IsContainerProject)' == ''">false</IsContainerProject>
		<IsCSharpProject Condition="'$(IsCSharpProject)' == ''">false</IsCSharpProject>
		<IsPackable Condition="'$(IsPackable)' == ''">false</IsPackable>
		<IsPublishable Condition="'$(IsPublishable)' == ''">false</IsPublishable>
		<IsSdkProject Condition="'$(IsSdkProject)' == ''">false</IsSdkProject>
		<IsSharedProject Condition="'$(IsSharedProject)' == ''">false</IsSharedProject>
		<IsSharedTestingProject Condition="'$(IsSharedTestingProject)' == ''"
			>false</IsSharedTestingProject
		>
		<IsTestProject Condition="'$(IsTestProject)' == ''">false</IsTestProject>
		<IsWebProject Condition="'$(IsWebProject)' == ''">false</IsWebProject>
		<IsWebSdkProject Condition="'$(IsWebSdkProject)' == ''">false</IsWebSdkProject>
		<IsWorkerSdkProject Condition="'$(IsWorkerSdkProject)' == ''">false</IsWorkerSdkProject>
		<LangVersion Condition="'$(LangVersion)' == ''"></LangVersion>
		<ManagePackageVersionsCentrally Condition="'$(ManagePackageVersionsCentrally)' == ''"
			>false</ManagePackageVersionsCentrally
		>
		<MaxCpuCount Condition="'$(MaxCpuCount)' == ''"></MaxCpuCount>
		<NoWarn Condition="'$(NoWarn)' == ''"></NoWarn>
		<Nullable Condition="'$(Nullable)' == ''"></Nullable>
		<OutputType Condition="'$(OutputType)' == ''"></OutputType>
		<Packable Condition="'$(Packable)' == ''">false</Packable>
		<PackageTags Condition="'$(PackageTags)' == ''"></PackageTags>
		<PackageVersion Condition="'$(PackageVersion)' == ''">$(Version)</PackageVersion>
		<ProjectSdkTestFramework Condition="'$(ProjectSdkTestFramework)' == ''"
			>TUnit</ProjectSdkTestFramework
		>
		<TestingFramework Condition="'$(TestingFramework)' == ''">TUnit</TestingFramework>
		<SubstituteFramework Condition="'$(SubstituteFramework)' == ''">TUnitMocks</SubstituteFramework>
		<TestDataFramework Condition="'$(TestDataFramework)' == ''">Bogus</TestDataFramework>
		<PurviewLogicalProjectName Condition="'$(PurviewLogicalProjectName)' == ''"
		></PurviewLogicalProjectName>
		<PurviewNamespacePrefix Condition="'$(PurviewNamespacePrefix)' == ''"
		></PurviewNamespacePrefix>
		<PurviewProjectShortName Condition="'$(PurviewProjectShortName)' == ''"
		></PurviewProjectShortName>
		<PurviewTestType Condition="'$(PurviewTestType)' == ''"></PurviewTestType>
		<PublishAot Condition="'$(PublishAot)' == ''">false</PublishAot>
		<PublishRepositoryUrl Condition="'$(PublishRepositoryUrl)' == ''">false</PublishRepositoryUrl>
		<PurviewDotNetProjectSdkVersionForGlobalJson
			Condition="'$(PurviewDotNetProjectSdkVersionForGlobalJson)' == ''"
			>1.0.0</PurviewDotNetProjectSdkVersionForGlobalJson
		>
		<RepositoryEditorConfigFilePath
			Condition="'$(RepositoryEditorConfigFilePath)' == ''"
		></RepositoryEditorConfigFilePath>
		<RepositoryGlobalJsonFilePath
			Condition="'$(RepositoryGlobalJsonFilePath)' == ''"
		></RepositoryGlobalJsonFilePath>
		<RootNamespace Condition="'$(RootNamespace)' == ''"></RootNamespace>
		<SdkProjectName Condition="'$(SdkProjectName)' == ''"></SdkProjectName>
		<SourceLinkPackageName Condition="'$(SourceLinkPackageName)' == ''"
			>Microsoft.SourceLink.GitHub</SourceLinkPackageName
		>
		<SymbolPackageFormat Condition="'$(SymbolPackageFormat)' == ''"></SymbolPackageFormat>
		<TargetFramework Condition="'$(TargetFramework)' == ''"></TargetFramework>
		<TargetProjectName Condition="'$(TargetProjectName)' == ''"></TargetProjectName>
		<TestingPlatformDotnetTestSupport Condition="'$(TestingPlatformDotnetTestSupport)' == ''"
			>false</TestingPlatformDotnetTestSupport
		>
		<TestingType Condition="'$(TestingType)' == ''"></TestingType>
		<UseMicrosoftTestingPlatformRunner Condition="'$(UseMicrosoftTestingPlatformRunner)' == ''"
			>false</UseMicrosoftTestingPlatformRunner
		>
		<Version Condition="'$(Version)' == ''">0.0.1</Version>

		<_PurviewSdkContainerDirectory
			Condition="'$(_PurviewSdkContainerDirectory)' == ''"
		></_PurviewSdkContainerDirectory>
		<_PurviewSdkContainerDirectoryName
			Condition="'$(_PurviewSdkContainerDirectoryName)' == ''"
		></_PurviewSdkContainerDirectoryName>
		<_PackageJsonVersion Condition="'$(_PackageJsonVersion)' == ''"></_PackageJsonVersion>
		<_RootPackageJsonText Condition="'$(_RootPackageJsonText)' == ''"></_RootPackageJsonText>
		<_RootPackageJsonWasSpecified Condition="'$(_RootPackageJsonWasSpecified)' == ''"
			>false</_RootPackageJsonWasSpecified
		>
		<_UsePackageJsonVersionEnabled Condition="'$(_UsePackageJsonVersionEnabled)' == ''"
			>false</_UsePackageJsonVersionEnabled
		>
		<_UsePackageJsonVersionNormalized
			Condition="'$(_UsePackageJsonVersionNormalized)' == ''"
		></_UsePackageJsonVersionNormalized>
		<RepoRoot Condition="'$(RepoRoot)' == ''"></RepoRoot>
		<RootPackageJson Condition="'$(RootPackageJson)' == ''"></RootPackageJson>
		<UsePackageJsonVersion Condition="'$(UsePackageJsonVersion)' == ''">true</UsePackageJsonVersion>
		<EnableVersionDetectionCache Condition="'$(EnableVersionDetectionCache)' == ''"
			>true</EnableVersionDetectionCache
		>
		<VersionDetectionCacheFile
			Condition="'$(VersionDetectionCacheFile)' == ''"
		></VersionDetectionCacheFile>
		<_VersionDetectionCacheDirectory
			Condition="'$(_VersionDetectionCacheDirectory)' == ''"
		></_VersionDetectionCacheDirectory>
		<_VersionDetectionCacheText
			Condition="'$(_VersionDetectionCacheText)' == ''"
		></_VersionDetectionCacheText>
		<_CachedRepoRoot Condition="'$(_CachedRepoRoot)' == ''"></_CachedRepoRoot>
		<_CachedRootPackageJson Condition="'$(_CachedRootPackageJson)' == ''"></_CachedRootPackageJson>
		<_CachedPackageJsonVersion
			Condition="'$(_CachedPackageJsonVersion)' == ''"
		></_CachedPackageJsonVersion>
		<_CachedPackageJsonTicks
			Condition="'$(_CachedPackageJsonTicks)' == ''"
		></_CachedPackageJsonTicks>
		<_CurrentPackageJsonTicks
			Condition="'$(_CurrentPackageJsonTicks)' == ''"
		></_CurrentPackageJsonTicks>
		<_VersionDetectionCacheKey
			Condition="'$(_VersionDetectionCacheKey)' == ''"
		></_VersionDetectionCacheKey>
		<_VersionDetectionCacheRoot
			Condition="'$(_VersionDetectionCacheRoot)' == ''"
		></_VersionDetectionCacheRoot>
	</PropertyGroup>
</Project>
