<Project>
	<PropertyGroup>
		<UsePackageJsonVersion Condition="'$(UsePackageJsonVersion)' == ''">true</UsePackageJsonVersion>
		<_UsePackageJsonVersionNormalized>$([System.String]::Copy('$(UsePackageJsonVersion)').ToLowerInvariant())</_UsePackageJsonVersionNormalized>
		<_UsePackageJsonVersionEnabled
			Condition="'$(_UsePackageJsonVersionNormalized)' == 'true' OR '$(_UsePackageJsonVersionNormalized)' == 'strict'"
			>true</_UsePackageJsonVersionEnabled
		>

		<_RootPackageJsonWasSpecified Condition="'$(RootPackageJson)' != ''"
			>true</_RootPackageJsonWasSpecified
		>
		<_RootPackageJsonWasSpecified Condition="'$(RootPackageJson)' == ''"
			>false</_RootPackageJsonWasSpecified
		>
	</PropertyGroup>

	<PropertyGroup Condition="'$(_UsePackageJsonVersionEnabled)' == 'true' and '$(_RootPackageJsonWasSpecified)' == 'true'">
		<RootPackageJson>$([MSBuild]::NormalizePath('$(RootPackageJson)'))</RootPackageJson>
	</PropertyGroup>

	<PropertyGroup Condition="'$(_UsePackageJsonVersionEnabled)' == 'true' and '$(_RootPackageJsonWasSpecified)' != 'true'">
		<RepoRoot>$([MSBuild]::GetDirectoryNameOfFileAbove('$(MSBuildProjectDirectory)', '.git'))</RepoRoot>
	</PropertyGroup>

	<PropertyGroup
		Condition="'$(_UsePackageJsonVersionEnabled)' == 'true'
                            and '$(_RootPackageJsonWasSpecified)' != 'true'
                            and '$(RepoRoot)' != ''"
	>
		<RootPackageJson>$([MSBuild]::NormalizePath('$(RepoRoot)', 'package.json'))</RootPackageJson>
	</PropertyGroup>

	<PropertyGroup
		Condition="'$(_UsePackageJsonVersionEnabled)' == 'true'
                            and '$(RootPackageJson)' != ''
                            and Exists('$(RootPackageJson)')"
	>
		<_RootPackageJsonText>$([System.IO.File]::ReadAllText('$(RootPackageJson)'))</_RootPackageJsonText>
		<_PackageJsonVersion>$([System.Text.RegularExpressions.Regex]::Match(
      '$(_RootPackageJsonText)',
      '&quot;version&quot;\s*:\s*&quot;([^&quot;]+)&quot;'
    ).Groups[1].Value)</_PackageJsonVersion>
	</PropertyGroup>

	<PropertyGroup Condition="'$(_UsePackageJsonVersionEnabled)' == 'true' and '$(_PackageJsonVersion)' != ''">
		<Version>$(_PackageJsonVersion)</Version>
		<PackageVersion>$(_PackageJsonVersion)</PackageVersion>
	</PropertyGroup>

	<ItemGroup>
		<CompilerVisibleProperty Include="UsePackageJsonVersion" />
		<CompilerVisibleProperty Include="RootPackageJson" />
		<CompilerVisibleProperty Include="RepoRoot" />
		<CompilerVisibleProperty Include="Version" />
		<CompilerVisibleProperty Include="PackageVersion" />
	</ItemGroup>
</Project>
