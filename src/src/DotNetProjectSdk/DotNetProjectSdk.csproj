<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<PackageId>Purview.DotNetProjectSdk</PackageId>
		<PackageType>MSBuildSdk</PackageType>
		<Description>A reusable MSBuild SDK that provides standardised .NET project defaults, code style enforcement, configurable testing framework wiring (TUnit, Xunit, or None), mocking provider wiring (TUnitMocks, NSubstitute, or None), and Central Package Management integration. Drop in via Directory.Build.props to apply uniformly across every project in a repo.</Description>
		<PackageTags>msbuild;sdk;build;tunit;xunit;tunitmock;nsubstitute;bogus;csharp;dotnet</PackageTags>
		<PackageProjectUrl>https://github.com/purview-dev/purview-dotnet-project-sdk</PackageProjectUrl>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<RepositoryType>git</RepositoryType>
		<PackageIcon>purview-logo.jpg</PackageIcon>

		<!-- No compiled output — this is a pure MSBuild SDK package -->
		<TargetFramework>netstandard2.0</TargetFramework>
		<IncludeBuildOutput>false</IncludeBuildOutput>
		<GenerateDocumentationFile>false</GenerateDocumentationFile>
		<DisableGenerateAssemblyInfoClass>true</DisableGenerateAssemblyInfoClass>
		<IsPackable>true</IsPackable>

		<!-- No telemetry packages for this meta-project -->
		<ExcludePurviewTelemetry>true</ExcludePurviewTelemetry>
		<ExcludeMSTelemetryExtension>true</ExcludeMSTelemetryExtension>
		<!-- Include the agents file for this SDK. -->
		<EnabledAgentFolderInPackage>true</EnabledAgentFolderInPackage>
		<ProjectAgentFolder>src/ProjectAgent</ProjectAgentFolder>
		<!-- NU5128: expected for MSBuildSdk packages — no lib/ref assemblies by design -->
		<NoWarn>$(NoWarn);NU5128</NoWarn>
		<!-- Allow dotfiles (e.g., .editorconfig) to be packed -->
		<NoDefaultExcludes>true</NoDefaultExcludes>
		<!-- No C# so no need to generate useful usings -->
		<AutoIncludeUsings>false</AutoIncludeUsings>
	</PropertyGroup>

	<PropertyGroup>
		<ProjectSdkSourceGeneratorProject>$(MSBuildThisFileDirectory)..\Analyzers\Analyzers.csproj</ProjectSdkSourceGeneratorProject>
		<ProjectSdkSourceGeneratorTargetFramework>netstandard2.0</ProjectSdkSourceGeneratorTargetFramework>
		<ProjectSdkSourceGeneratorAssembly>$(MSBuildThisFileDirectory)..\Analyzers\bin\$(Configuration)\$(ProjectSdkSourceGeneratorTargetFramework)\Purview.DotNetProjectSdk.Analyzers.dll</ProjectSdkSourceGeneratorAssembly>
		<TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);IncludeProjectSdkSourceGenerator</TargetsForTfmSpecificContentInPackage>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference
			Include="$(ProjectSdkSourceGeneratorProject)"
			PrivateAssets="all"
			ReferenceOutputAssembly="false"
			OutputItemType="Analyzer"
		/>
	</ItemGroup>

	<Target Name="IncludeProjectSdkSourceGenerator" DependsOnTargets="Build">
		<Error
			Condition="!Exists('$(ProjectSdkSourceGeneratorAssembly)')"
			Text="The Project SDK source generator was not found at '$(ProjectSdkSourceGeneratorAssembly)'."
		/>

		<ItemGroup>
			<TfmSpecificPackageFile Include="$(ProjectSdkSourceGeneratorAssembly)">
				<PackagePath>analyzers/dotnet/cs/</PackagePath>
			</TfmSpecificPackageFile>
		</ItemGroup>
	</Target>

	<!-- Pack the Sdk/ folder to the Sdk/ path in the NuGet package.
	     .editorconfig must be listed explicitly — NuGet excludes dotfiles by default. -->
	<ItemGroup>
		<None Include="Sdk/**/*" Pack="true" PackagePath="Sdk/" />

		<None Include="$(MSBuildThisFileDirectory)../../../README.md" Pack="true" PackagePath="/" />
		<None
			Include="$(MSBuildThisFileDirectory)../../../LICENSE.md"
			Pack="true"
			PackagePath="/"
		/>
		<None
			Include="$(MSBuildThisFileDirectory)../../../assets/images/purview-logo.jpg"
			Pack="true"
			PackagePath="/"
		/>
	</ItemGroup>
</Project>
