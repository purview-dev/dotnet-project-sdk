<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!--
			Sdk.props computes: Purview.Purview.DotNetProjectSdk.Analyzers.UnitTests → Purview.Purview.DotNetProjectSdk.Analyzers.
			Override to the correct namespace.
		-->
		<RootNamespace>Purview.DotNetProjectSdk.Analyzers.Tests</RootNamespace>
	</PropertyGroup>

	<ItemGroup>
		<!-- Remove the double-prefix using added by Sdk.props before our RootNamespace override takes effect. -->
		<Using Remove="Purview.Purview.DotNetProjectSdk.Analyzers" />
		<Using Include="Purview.DotNetProjectSdk.Analyzers.Tests" />

		<!--
			Sdk.props auto-wires a ProjectReference to ../../src/Purview.DotNetProjectSdk.Analyzers/ — keep it.
			The analyzer project's InternalsVisibleToTarget generates IVT for "Purview.DotNetProjectSdk.Analyzers.UnitTests",
			granting access to internal types like EditorBrowsableSuppressor.
		-->

		<!-- Need the Roslyn compilation API directly for analyzer tests. -->
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
	</ItemGroup>

</Project>
